{
  "name": "petrea",
  "type": "module",
  "version": "0.4.2",
  "packageManager": "pnpm@11.1.2",
  "description": "A type-stripper that blanks TypeScript-only syntax using the oxc parser, preserving line and column positions.",
  "license": "MIT",
  "repository": "Teages/petrea",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/wasm.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "default": "./dist/register.mjs"
    },
    "./wasm": {
      "types": "./dist/wasm.d.mts",
      "default": "./dist/wasm.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "browser": "./dist/wasm.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts"
      ],
      "register": [
        "./dist/register.d.mts"
      ],
      "wasm": [
        "./dist/wasm.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "pnpm build:native && pnpm build:wasm && pnpm build:js",
    "build:native": "napi build --platform --release --manifest-path native/Cargo.toml --output-dir binaries",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:js": "obuild",
    "prepare-packages": "node scripts/prepare-packages.mjs",
    "play:prepare": "obuild --stub",
    "play": "pnpm -C playground play",
    "dev": "vitest dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "prepack": "pnpm build:js",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck",
    "bench": "vitest bench --run"
  },
  "napi": {
    "binaryName": "binding",
    "packageName": "@petrea/binding",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/cli": "^3.9.0",
    "@napi-rs/wasm-runtime": "^1.2.3",
    "@petrea/binding-wasm32-wasip1": "workspace:*",
    "@tybys/wasm-util": "^0.10.3",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.6",
    "emnapi": "2.0.0-alpha.5",
    "eslint": "^10.3.0",
    "jiti": "2.7.0",
    "obuild": "^0.4.35",
    "oxc-parser": "^0.148.0",
    "oxidase": "^0.0.3",
    "pkg-pr-new": "^0.0.88",
    "ts-blank-space": "^0.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
